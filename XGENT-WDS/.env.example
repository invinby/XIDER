# Общий секрет HMAC-SHA256 (должен совпадать во всех трёх папках).
# Сгенерируйте сильный случайный ключ, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SHARED_KEY=
ENCRYPT_PAYLOAD=true

# MQTT-брокер (по умолчанию публичный EMQX)
# MQTT_BROKER=broker.emqx.io
# MQTT_PORT=1883
# MQTT_PREFIX=xgent/v1
# MQTT_TLS=true — включить TLS (для приватного брокера)
# MQTT_USERNAME=<логин>
# MQTT_PASSWORD=<пароль>
# ENCRYPT_PAYLOAD=true — шифрование содержимого (AES-256-GCM), включить ВЕЗДЕ
