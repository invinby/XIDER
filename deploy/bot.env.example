# Copy this file to /etc/xider/bot.env on the VPS. Never commit real values.
SHARED_KEY=replace-with-a-long-random-value
BOT_TOKEN=replace-with-the-token-from-BotFather
ADMIN_ID=replace-with-your-telegram-user-id
MQTT_BROKER=replace-with-your-tls-broker-host
MQTT_PORT=8883
MQTT_PREFIX=xgent/v1
MQTT_TLS=true
MQTT_USERNAME=replace-with-broker-user
MQTT_PASSWORD=replace-with-broker-password
ENCRYPT_PAYLOAD=true
# Optional for enrolled devices; keep this directory outside the checkout.
# XIDER_DEVICE_KEYS_DIR=/etc/xider/device-keys
# X-DOCK stays disabled until the dedicated broker, TLS reverse proxy,
# owner approval, and platform installers have passed live checks.
# XIDER_DOCK_ENABLED=false
# XIDER_DOCK_DB=/var/lib/xider/enrollment.sqlite3
# XIDER_DOCK_BROKER_HOST=broker.example.org
# XIDER_DOCK_BROKER_PORT=8883
# XIDER_DOCK_BOT_USERNAME=replace-with-bot-only-broker-user
# XIDER_DOCK_BOT_PASSWORD=replace-with-bot-only-broker-password
# XIDER_DOCK_ADMIN_USERNAME=replace-with-dynsec-admin-user
# XIDER_DOCK_ADMIN_PASSWORD=replace-with-dynsec-admin-password
# XIDER_DOCK_HTTP_PORT=8787
