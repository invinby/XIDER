# Copy this file to /etc/xider/bot.env on the VPS. Never commit real values.
SHARED_KEY=replace-with-a-long-random-value
BOT_TOKEN=replace-with-the-token-from-BotFather
ADMIN_ID=replace-with-your-telegram-user-id
MQTT_BROKER=replace-with-your-tls-broker-host
MQTT_PORT=8883
MQTT_PREFIX=xgent/v1
MQTT_TLS=true
MQTT_USERNAME=replace-with-broker-user
MQTT_PASSWORD=replace-with-broker-password
ENCRYPT_PAYLOAD=true
