[Unit]
Description=XIDER Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xider
Group=xider
WorkingDirectory=/opt/xider/TG-BOT-SERVER
EnvironmentFile=/etc/xider/bot.env
ExecStart=/opt/xider/TG-BOT-SERVER/venv/bin/python -u bot.py --serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/xider/TG-BOT-SERVER

[Install]
WantedBy=multi-user.target
