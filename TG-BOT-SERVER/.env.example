# SHARED_KEY (ОБЯЗАТЕЛЬНО) — общий секрет HMAC-SHA256.
# Должен СОВПАДАТЬ во всех трёх папках проекта: TG-BOT-SERVER, XGENT-MCS, XGENT-WDS.
# Сгенерируйте сильный случайный ключ, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SHARED_KEY=
ENCRYPT_PAYLOAD=true

# Токен Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО).
BOT_TOKEN=

# Telegram ID администратора — единственный пользователь, которому
# разрешено управление (ОБЯЗАТЕЛЬНО). Узнать свой ID: @userinfobot.
ADMIN_ID=

# MQTT-брокер (заполнить значениями приватного брокера)
MQTT_BROKER=
MQTT_PORT=8883
MQTT_PREFIX=xgent/v1
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
# ENCRYPT_PAYLOAD=true — шифрование содержимого (AES-256-GCM), включить ВЕЗДЕ
